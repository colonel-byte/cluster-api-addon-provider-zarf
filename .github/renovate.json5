{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Pin GitHub Actions to a commit SHA with the tag in a trailing comment. That is the
    // only immutable form and what OpenSSF Scorecard's Pinned-Dependencies counts; see
    // .github/AGENTS.md. Without this, Renovate rewrites a pinned `uses:` back to a tag.
    "helpers:pinGitHubActionDigests",
  ],

  assignees: [
    "@A1994SC",
  ],

  // PR titles must pass the conventional-commit lint in .github/workflows/commitlint.yaml.
  // config:recommended only auto-detects this from recent commit history, so state it:
  // every Renovate PR title is `chore(deps): ...`, regardless of what history looks like.
  semanticCommits: "enabled",

  // config:recommended ships an ignorePaths that includes `**/test/**`, which silently hides
  // test/e2e/go.mod - the one module here that is neither vendored nor covered by the root
  // tidy, and so the one most able to drift unnoticed. Restated without that entry, and
  // without `**/__tests__/**` and `**/tests/**` for the same reason should either name ever
  // appear. `**/vendor/**` stays: a vendored module's own go.mod is upstream's, not ours to
  // bump, and rewriting one would make the next `go mod vendor` look like a change nobody
  // made. The rest are carried over from the preset unchanged.
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__fixtures__/**",
  ],

  ignoreUnstable: false,
  separateMajorMinor: false,
  dependencyDashboard: {
    "enabled": true,
    "autoclose": false,
    "title": "Dependency Dashboard",
    "header": "This issue lists Renovate updates and detected dependencies.",
    "osvVulnerabilitySummary": "unresolved",
    "reportAbandonment": true,
    "pinned": false,
    "customize": {}
  },

  // Every update is reviewed and merged by a person. Stated rather than left to the default,
  // so a preset added to `extends` above cannot quietly turn it on - `config:recommended`
  // does not, but several of the `:automergeX` presets do, and the grouped rules below would
  // then merge a whole family of modules on one green run.
  automerge: false,

  // One pull request per module, throttled - the Dependabot shape. Ungrouping alone turns
  // 260 pending updates into 260 pull requests at once; these are what make it a queue
  // instead, and they are the half of the arrangement that actually matters. 5 open and 2
  // new per hour mirrors Dependabot's `open-pull-requests-limit` default, so the backlog
  // drains at a rate a person can review. Renovate parks the remainder on the dependency
  // dashboard rather than dropping it - nothing is lost, it just waits.
  //
  // Raising these is the lever if the queue drains too slowly; `prConcurrentLimit: 0` means
  // unlimited, which is the state this is here to prevent.
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  branchConcurrentLimit: 5,

  // Commit through the GitHub API rather than over git. Renovate recommends this when the
  // token is a GitHub App installation token, which is what .github/workflows/renovate.yaml
  // mints - it is also what gets the commits attributed to the app and signed by GitHub.
  // Drop it if this repository goes back to the hosted renovate[bot] app.
  platformCommit: "enabled",

  packageRules: [
    // Container images (Dockerfile bases, workflow runner images) move separately from the
    // annotated release pins: an image digest bump and a tool-version bump are reviewed by
    // different evidence.
    {
      matchDatasources: [
        "docker",
      ],
      addLabels: [
        "renovate/oci",
      ],
      groupName: "container images",
      groupSlug: "docker",
      matchPackageNames: [
        "*",
      ],
    },
    // The annotated pins (magefiles constants, workflow tool versions) - everything the
    // custom regex managers below surface, minus zarf, which the zarf rule further down
    // pulls into its own group.
    {
      matchDatasources: [
        "regex",
        "git-tags",
        "github-releases",
      ],
      addLabels: [
        "renovate/pin",
      ],
      groupName: "release pins",
      groupSlug: "release-pins",
      matchPackageNames: [
        "*",
      ],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: [
        "renovate/action",
      ],
      groupName: "all-actions",
      groupSlug: "all-actions",
      matchPackageNames: [
        "*",
      ],
    },
    {
      matchManagers: ["gomod"],
      addLabels: [
        "renovate/gomod",
      ],
      groupName: "go direct",
      groupSlug: "gomod-direct",
      matchPackageNames: [
        "*",
      ],
    },
    // gomod leaves `// indirect` requirements alone by default; opt them in so the grouped
    // go-modules PRs carry them too.
    {
      matchManagers: ["gomod"],
      matchDepTypes: ["indirect"],
      enabled: true,
    },
    // Named gomod groups, split out of the all-gomod catch-all above - rules apply in
    // order and the last match wins, so these must stay below it.
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
      groupName: "k8s",
      groupSlug: "k8s",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["golang.org/x/**"],
      groupName: "golang",
      groupSlug: "golang",
    },
    // zarf is the load-bearing direct dependency - a bump of it changes deploy behavior -
    // so it gets a PR of its own rather than riding in a group. The Go module and the
    // annotated release pin (zarf.yaml, the publish workflow) describe the same version
    // and the deploy stack vendors the packager surface, so both names move together here.
    {
      matchPackageNames: [
        "github.com/zarf-dev/zarf",
        "zarf-dev/zarf",
      ],
      groupName: "zarf",
      groupSlug: "zarf",
    },
    // Everything indirect moves as one mechanical PR, reviewed by the vendored offline
    // build and the test suite rather than by reading 170 version lines. It wins over the
    // family groups above, so an indirect k8s.io bump rides here, not in the k8s PR.
    {
      matchManagers: ["gomod"],
      matchDepTypes: ["indirect"],
      groupName: "go indirect",
      groupSlug: "gomod-indirect",
    },
    // The two families below sit under the indirect rule on purpose: their members are
    // entirely indirect (the zarf/cosign fan-out), and these rules carve them back out of
    // the indirect blob into PRs of their own.
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/go-openapi/**"],
      groupName: "openapi",
      groupSlug: "openapi",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: [
        "cloud.google.com/go/**",
        "github.com/AliyunContainerService/ack-ram-tool/**",
        "github.com/Azure/**",
        "github.com/AzureAD/**",
        "github.com/alibabacloud-go/**",
        "github.com/aws/**",
        "github.com/awslabs/**",
        "github.com/google/**",
        "github.com/googleapis/**",
        "github.com/hashicorp/**",
        "github.com/mozillazg/docker-credential-acr-helper/**",
        "github.com/sigstore/**",
        "github.com/spiffe/**",
        "github.com/theupdateframework/**",
        "google.golang.org/**",
      ],
      groupName: "cloud-kms",
      groupSlug: "cloud-kms",
    },
    {
      matchManagers: ["pre-commit"],
      addLabels: [
        "renovate/pre-commit",
      ],
      groupName: "pre-commit hooks",
      groupSlug: "all-pre-commit",
    },
    // The only npm in the tree is the pinned commitlint CLI that the PR Title Check workflow
    // installs with `npm ci`. Grouped so its two packages, which share a version, move
    // together rather than as two pull requests that each fail until the other lands.
    {
      matchManagers: ["npm"],
      addLabels: [
        "renovate/npm",
      ],
      groupName: "commitlint",
      groupSlug: "commitlint",
    },
    // Indirect majors are not upgrade decisions, and Renovate's are mostly not real. It
    // resolves a major by probing `module/vN`; where that path does not exist it falls back
    // to the repository's git tags, which produces `golang.org/x/time v0.16.0 -> v3.0.1`,
    // `google.golang.org/protobuf v1.36.12 -> v5.9.11`, and four outright downgrades. A
    // 2026-11-23 dry run against v44.258.1 typed 42 updates `major`; 41 were indirect.
    //
    // Nothing in this module imports an indirect requirement, so its major is not ours to
    // pick - it arrives when a direct dependency asks for it. Disabling them also retires a
    // second failure: Renovate computes
    // `mustSkipGoModTidy = !postUpdateOptions.includes("gomodUpdateImportPaths") && updateType === "major"`,
    // and that flag gates every tidy variant, so a major branch runs `go get` and `go mod
    // vendor` but never `go mod tidy` - which check-go-mod.yaml then fails on the tidy diff.
    // With `gomodUpdateImportPaths` deliberately absent (#66), every major PR failed that
    // check by construction. A direct major still reaches us, and still needs tidy by hand.
    {
      matchManagers: ["gomod"],
      matchDepTypes: ["indirect"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    // Dissolve the gomod groups: a branch per module, named `renovate/<module>-<major>.x`.
    // The groups above stay in the file and keep applying their labels - `groupName: null`
    // removes only the grouping, and the rules are still what attaches `renovate/gomod` and
    // decides what is enabled. This sits last so it wins over all of them.
    //
    // The trade this makes is the opposite of the one the groups made, and it is only
    // affordable because of the limits at the top of this file. The counts, from the
    // 2026-11-23 dry run: 170 indirect updates, 82 in the cloud-kms families, 8 openapi, 1
    // direct. Ungrouped and throttled to 2 per hour, a full backlog takes days to drain -
    // which is the intended behaviour, not a problem to solve, because each one arrives with
    // its own vendored diff and its own CI run. Re-group a family by deleting this rule's
    // match for it if the trickle is not worth the per-module isolation.
    {
      matchManagers: ["gomod"],
      groupName: null,
    },
    // The `go` directive and the toolchain line are a decision about the language version,
    // not a dependency update, so they are not Renovate's to move.
    {
      matchDepTypes: ["golang"],
      enabled: false,
    },
    // test/e2e requires this repository's own module and replaces it with `../..`, so the
    // version on that require line is a placeholder the replace overrides - the code built is
    // always the working tree's. Renovate cannot see the replace as making the version moot,
    // so it would keep proposing pseudo-version bumps that change nothing and whose only
    // effect is to re-tidy a file CI already pins.
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/colonel-byte/cluster-api-addon-provider-zarf"],
      enabled: false,
    },
  ],

  // A vendored tree has to be regenerated in the same commit, or the branch does not build.
  // Drop this in a repository that does not vendor. `gomodUpdateImportPaths` is deliberately
  // absent: the import-path rewriter loads the package graph, which a vendored tree forces
  // into -mod=vendor against a vendor/ that has not been regenerated yet, so every grouped
  // PR carrying a major bump fails its artifact step and lands as a bare go.mod edit (#66).
  // The majors that reach the grouped PRs are all indirect - nothing here imports them, so
  // there is no path to rewrite. A direct major bump gets its import paths rewritten by hand.
  postUpdateOptions: [
    "gomodTidy",
  ],

  // Renovate re-runs `go mod vendor` for every gomod update, and that deletes the two generated
  // osv-scanner.toml files under vendor/ - so without this every dependency bump would arrive
  // with check-go-mod red and need a hand-written commit to put them back. See
  // docs/agent/choice-osv-vendor-overrides.md.
  //
  // This is the self-hosted-only half of the config, and it is inert without its other half:
  // `allowedCommands` is a global option Renovate refuses to read from a repository config, so
  // it is set as RENOVATE_ALLOWED_COMMANDS in .github/workflows/renovate.yaml. A command that
  // does not match it is skipped with a warning in the log and nothing else - the failure mode
  // is a red pull request, not an error here.
  //
  // `executionMode: "branch"` runs it once after all of a branch's updates rather than once per
  // upgrade; the files do not vary by module, so per-upgrade runs would be identical work.
  // `fileFilters` is what lets Renovate commit the result: files a post-upgrade task writes are
  // discarded unless they match, and these are exactly the paths the target writes.
  postUpgradeTasks: {
    commands: [
      "go run ./magefiles/core dev:writeOSVOverrides",
    ],
    fileFilters: [
      "**/osv-scanner.toml",
    ],
    executionMode: "branch",
  },

  customManagers: [
    {
      customType: "regex",
      description: [
        "Process custom dependencies",
      ],
      managerFilePatterns: [
        "/(^|/).+\\.ya?ml(\\.j2)?$/",
      ],
      matchStrings: [
        "(?m:# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>[a-z-0-9]+?))?( repository=(?<registryUrl>\\S+))?\n.+?: ?\"?(?<currentValue>[^\"\\s]+)\"?$)",
        "(?m:# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>[a-z-0-9]+?))?( repository=(?<registryUrl>\\S+))?\n.+?(?<currentValue>(?:v|\\d|\\.)+)$)",
        "(?m:# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>[a-z-0-9]+?))?\n.+?/(?<currentValue>(v|\\d)[^/]+)\\S+$)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    // TEMPLATE: this is how a pin that lives in a Go constant, a Dockerfile, or a JSON pins
    // file gets an owner rather than a bump procedure - see the "Pinned versions, digests,
    // and checksums" section of the root AGENTS.md. Annotate the line above the pin with
    // `// renovate: datasource=… depName=…` and Renovate moves it. Delete this block if
    // every pin in the repository is already in a file a real manager understands.
    {
      customType: "regex",
      description: [
        "Pins annotated in Go source, Dockerfiles, and shell scripts",
      ],
      managerFilePatterns: [
        "/(^|/).+\\.go$/",
        "/(^|/)Dockerfile[^/]*$/",
        "/(^|/).+\\.sh$/",
      ],
      matchStrings: [
        "(?m:(?:#|//) renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>[a-z-0-9]+?))?(?: extractVersion=(?<extractVersion>\\S+?))?\n.*?\"?v?(?<currentValue>\\d+(?:\\.\\d+)+(?:-[^\"\\s]+)?)\"?.*$)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],
}
